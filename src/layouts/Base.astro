---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  // Pages that already render their own "← Back to X" link (in the same
  // back-link spot, at the top of their hero) pass backLink={false} so this
  // layout doesn't stack a second, generic one above it. Every other page
  // gets this one for free, in that same top-left position — never floating.
  backLink?: boolean;
}

const pathname = Astro.url.pathname;

const {
  title,
  description = 'Clear, project-driven learning paths for modern careers.',
  wide = false,
  backLink = pathname !== '/',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => `${base}${href}` || '/';
const ogImage = new URL(withBase('/og-node-map.png'), Astro.site ?? Astro.url).toString();
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const explore = [
  { href: '/roadmaps', label: 'Roadmaps' },
  { href: '/skill-roadmaps', label: 'Skill Roadmaps' },
  { href: '/skills', label: 'Topics' },
  { href: '/projects', label: 'Projects' },
  { href: '/resources', label: 'Resources' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f2" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · StagePath`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · StagePath`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title} · StagePath</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="nav-shell">
        <a href={withBase('/')} class="brand" aria-label="StagePath home">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>Stage<span>Path</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {explore.map((item) => <a href={withBase(item.href)} class:list={{ active: isActive(item.href) }}>{item.label}</a>)}
        </nav>
        <div class="nav-actions">
          <details class="mobile-menu">
            <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
            <div class="mobile-menu-panel">
              <p>Explore</p>
              {[...explore, { href: '/start', label: 'Find my path' }].map((item) => <a href={withBase(item.href)} class:list={{ active: isActive(item.href) }}>{item.label}</a>)}
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content" class:list={['page-shell', { 'page-shell-wide': wide }]}>
      {backLink && <button type="button" id="global-back-btn" class="back-link global-back-btn" aria-label="Go back"><span aria-hidden="true">←</span> Back</button>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-shell">
        <div>
          <div class="brand-row">
            <a href={withBase('/')} class="brand brand-footer"><span class="brand-mark" aria-hidden="true">S</span><span>Stage<span>Path</span></span></a>
            <span class="brand-credit">by <a href="https://www.linkedin.com/in/ankitanshu01/" target="_blank" rel="noopener noreferrer">Ankit Anshu</a></span>
          </div>
          <p class="footer-tagline">Clear roadmaps from first topic to finished project.</p>
        </div>
        <div class="footer-links">
          <div><strong>Explore</strong><a href={withBase('/roadmaps')}>Roadmaps</a><a href={withBase('/skill-roadmaps')}>Skill roadmaps</a><a href={withBase('/skills')}>Skill library</a><a href={withBase('/projects')}>Projects</a></div>
          <div><strong>Learn</strong><a href={withBase('/start')}>Find a path</a><a href={withBase('/resources')}>Resources</a><a href={withBase('/projects')}>Project briefs</a></div>
          <div><strong>Project</strong><a href={withBase('/about')}>About</a><a href="https://github.com" target="_blank" rel="noopener noreferrer">Open source ↗</a></div>
        </div>
      </div>
    </footer>
    <script is:inline define:vars={{ homeHref: withBase('/') }}>
      const goBackBtn = document.getElementById('global-back-btn');
      goBackBtn?.addEventListener('click', () => {
        if (window.history.length > 1) window.history.back();
        else window.location.href = homeHref;
      });
    </script>
    <script is:inline define:vars={{ base }}>
      if (base) {
        const prefixLinks = (root = document) => {
          root.querySelectorAll('a[href^="/"]').forEach((link) => {
            const href = link.getAttribute('href');
            if (href && href !== base && !href.startsWith(`${base}/`)) link.setAttribute('href', `${base}${href}`);
          });
        };
        prefixLinks();
        new MutationObserver((records) => {
          for (const record of records) {
            for (const node of record.addedNodes) if (node instanceof Element) prefixLinks(node);
          }
        }).observe(document.body, { childList: true, subtree: true });
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target || link.hasAttribute('download')) return;
          const url = new URL(link.href, window.location.href);
          if (url.origin === window.location.origin && !url.pathname.startsWith(`${base}/`) && url.pathname !== base) {
            event.preventDefault();
            window.location.href = `${base}${url.pathname}${url.search}${url.hash}`;
          }
        });
      }
    </script>
  </body>
</html>
