---
// Generic skill-based roadmap page ("/skill-roadmaps/[id]"), one per entry
// in src/lib/skill-roadmaps.ts (SKILL_ROADMAPS) — NOT the 8 curriculum-tree
// technologies (SQL, Python, ...), which each have their own dedicated page
// instead (see src/pages/skill-roadmaps/sql.astro). This one derives its
// topic list from the shared `skills` collection and orders it purely by
// prerequisite chain, so each topic is a real, clickable link to its own
// skill page rather than a plain text tile.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SKILL_ROADMAPS, orderByPrerequisites } from '../../lib/skill-roadmaps';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  return SKILL_ROADMAPS.map((def) => {
    const items = orderByPrerequisites(skills.filter((skill) => def.match(skill.id)));
    return { params: { id: def.id }, props: { def, items } };
  }).filter(({ props }) => props.items.length > 0);
}

const { def, items } = Astro.props;
const subtopicCount = items.reduce((sum, skill) => sum + (skill.data.subtopics.length || skill.data.objectives.length), 0);
const minutes = items.reduce((sum, skill) => sum + (skill.data.estimated_minutes || 0), 0);

// Same accent palette the career roadmap track uses, cycled per stop —
// each individual topic is its own node here (there are no multi-skill
// stages to group), so the node itself carries the accent instead of a
// separate stage badge.
const ACCENTS = ['#146c43', '#b5482f', '#3a5ba0', '#8667c8', '#a97b26', '#1f7a8c', '#8a3b5e', '#4a6b3f', '#475569'];

const nodeDetails = items.map((skill, index) => ({
  skill,
  index,
  accent: ACCENTS[index % ACCENTS.length],
  depth: skill.data.subtopics.length || skill.data.objectives.length,
}));
---

<Base title={`${def.title} Roadmap`} description={def.description} wide>
  <header class="roadmap-hero">
    <div class="hero-main">
      <div class="hero-tags"><span>Skill roadmap</span></div>
      <h1>{def.title}</h1>
      <p>{def.description}</p>
    </div>
    <aside class="roadmap-summary">
      <p>Roadmap depth</p>
      <div><strong>{items.length}</strong><span>topics</span></div>
      <div><strong>{subtopicCount}</strong><span>subtopics</span></div>
      {minutes > 0 && <div><strong>~{Math.max(1, Math.round(minutes / 60))}h</strong><span>estimated effort</span></div>}
      <small>Ordered by each topic's own prerequisites, independent of any single career track.</small>
    </aside>
  </header>

  <section class="how-to-read">
    <strong>How to use this map</strong>
    <span><i class="dot" style="--c:#146c43"></i> Follow the numbered path top to bottom</span>
    <span><i class="dot outline"></i> Each stop is one topic — click it to open the full page</span>
  </section>

  <div class="roadmap-shell">
    <div class="stage-track" id="stage-track">
      <svg class="track-svg" id="track-svg" aria-hidden="true"><path id="track-path"></path></svg>
      <div class="track-start"><span>START</span></div>

      {nodeDetails.map(({ skill, index, accent, depth }) => (
        <div class="stage-node" data-side={index % 2 === 0 ? 'right' : 'left'}>
          <div class="stage-row">
            <a class="stage-badge" href={`/skills/${skill.id}`} style={`--accent:${accent}`}>
              <span class="badge-icon" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="badge-copy">
                <small>Topic {index + 1}</small>
                <strong>{skill.data.title}</strong>
                <p>{depth} subtopics{skill.data.estimated_minutes ? ` · ~${Math.max(1, Math.round(skill.data.estimated_minutes / 60))}h` : ''}</p>
              </div>
            </a>
          </div>
        </div>
      ))}

      <div class="track-finish"><span>BUILD. EXPLAIN. REPEAT.</span><strong>You reached the end of the path—not the end of learning.</strong><a href="/skill-roadmaps">Browse another skill roadmap →</a></div>
    </div>
  </div>

  <script>
    function drawTrack() {
      const track = document.getElementById('stage-track');
      const svg = document.getElementById('track-svg');
      const path = document.getElementById('track-path');
      if (!track || !svg || !path) return;
      const badges = Array.from(track.querySelectorAll('.stage-badge'));
      const startDot = track.querySelector('.track-start');
      if (badges.length < 1) return;

      const containerRect = track.getBoundingClientRect();
      const width = track.scrollWidth;
      const height = track.scrollHeight;
      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);

      const anchorOf = (el: Element) => {
        const r = el.getBoundingClientRect();
        return { x: r.left + r.width / 2 - containerRect.left, y: r.top + r.height / 2 - containerRect.top };
      };

      const points = [];
      if (startDot) points.push(anchorOf(startDot));
      for (const b of badges) points.push(anchorOf(b));

      if (points.length < 2) { path.setAttribute('d', ''); return; }

      // Consecutive nodes already sit at alternating left/right x-positions
      // (see .stage-row's justify-content below), so a plain bezier through
      // the real points gives one continuous, smoothly winding curve
      // instead of snapping back to center at every stop.
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 1; i < points.length; i++) {
        const p0 = points[i - 1];
        const p1 = points[i];
        const midY = (p0.y + p1.y) / 2;
        d += ` C ${p0.x} ${midY}, ${p1.x} ${midY}, ${p1.x} ${p1.y}`;
      }
      path.setAttribute('d', d);
    }

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(drawTrack, 120); });
    window.addEventListener('load', drawTrack);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawTrack);
    document.addEventListener('DOMContentLoaded', drawTrack);
    drawTrack();
    setTimeout(drawTrack, 300);
  </script>
</Base>

<style>
  .roadmap-hero { display: grid; grid-template-columns: 1fr 315px; gap: 70px; padding: 15px 0 50px; }
  .back-link { display: inline-block; margin-bottom: 27px; color: var(--muted); font-size: 12px; font-weight: 700; }
  .hero-tags { display: flex; gap: 7px; }.hero-tags span { padding: 5px 9px; border-radius: 7px; background: var(--green-soft); color: var(--green-dark); font-size: 9px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .hero-main h1 { margin: 15px 0 0; color: var(--green); font-size: clamp(48px, 7vw, 78px); letter-spacing: -.065em; line-height: .95; }.hero-main > p { max-width: 760px; margin: 19px 0 0; color: var(--muted); font-size: 18px; }
  .roadmap-summary { padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: white; }.roadmap-summary > p { margin: 0 0 12px; color: #818b83; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }.roadmap-summary > div { display: flex; align-items: baseline; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #edf0ec; }.roadmap-summary strong { font-size: 21px; }.roadmap-summary span { color: var(--muted); font-size: 11px; }.roadmap-summary small { display: block; margin-top: 15px; color: #8b958d; font-size: 9px; line-height: 1.5; }
  .how-to-read { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; padding: 14px 19px; border: 1px solid var(--line); border-radius: 12px; background: #fafbf8; font-size: 10px; }.how-to-read > strong { color: var(--ink); }.how-to-read span { display: flex; align-items: center; gap: 7px; color: var(--muted); }.how-to-read .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--c, var(--green)); }.how-to-read .outline { background: none; border: 2px solid var(--green); }

  .roadmap-shell { display: flex; justify-content: center; margin-top: 48px; }
  .stage-track { position: relative; width: 100%; max-width: 660px; min-width: 0; padding-bottom: 10px; }
  .track-svg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: visible; }
  .track-svg path { fill: none; stroke: #3a5ba0; stroke-width: 3.5; stroke-dasharray: 1 10; stroke-linecap: round; opacity: .55; }
  .track-start { position: relative; z-index: 2; display: flex; justify-content: center; margin-bottom: 40px; }
  .track-start span { padding: 8px 13px; border-radius: 20px; background: var(--navy); color: var(--lime); font-size: 9px; font-weight: 850; letter-spacing: .1em; }

  .stage-node { position: relative; z-index: 2; margin-bottom: 26px; }
  .stage-row { display: flex; }
  .stage-node[data-side='right'] .stage-row { justify-content: flex-end; }
  .stage-node[data-side='left'] .stage-row { justify-content: flex-start; }
  .stage-badge { position: relative; z-index: 3; display: flex; align-items: center; width: 300px; gap: 12px; padding: 14px; border: 2px solid color-mix(in srgb, var(--accent) 45%, var(--line)); border-radius: 14px; background: color-mix(in srgb, var(--accent) 5%, white); color: var(--ink); box-shadow: 0 8px 20px color-mix(in srgb, var(--accent) 14%, transparent); transition: transform .15s, box-shadow .15s; }
  .stage-badge:hover { transform: translateY(-3px); box-shadow: 0 14px 30px color-mix(in srgb, var(--accent) 28%, transparent); }
  .badge-icon { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 10px; background: var(--accent); color: white; font-size: 11px; font-weight: 850; }
  .badge-copy { min-width: 0; }
  .badge-copy small { display: block; color: var(--accent); font-size: 8px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .badge-copy strong { display: block; margin-top: 2px; font-size: 14px; letter-spacing: -.02em; }
  .badge-copy p { margin: 3px 0 0; color: var(--muted); font-size: 10px; line-height: 1.35; }

  .track-finish { position: relative; z-index: 2; width: min(520px, 90%); margin: 10px auto 0; padding: 24px; border-radius: 17px; background: var(--navy); color: white; text-align: center; }.track-finish span, .track-finish strong, .track-finish a { display: block; }.track-finish span { color: var(--lime); font-size: 8px; font-weight: 850; letter-spacing: .11em; }.track-finish strong { margin: 6px auto 13px; max-width: 380px; font-size: 16px; }.track-finish a { color: var(--lime); font-size: 10px; font-weight: 800; }

  @media (max-width: 950px) {
    .roadmap-hero { grid-template-columns: 1fr; gap: 30px; }.roadmap-summary { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }.roadmap-summary > p, .roadmap-summary small { grid-column: 1 / 4; }.roadmap-summary > div { display: block; border-bottom: 0; }.roadmap-summary span { display: block; }
  }
  @media (max-width: 700px) {
    .hero-main > p { font-size: 16px; }.roadmap-summary { grid-template-columns: 1fr 1fr; }.roadmap-summary > p, .roadmap-summary small { grid-column: 1 / 3; }
    .how-to-read { align-items: flex-start; flex-direction: column; gap: 8px; }
    .stage-node[data-side='right'] .stage-row, .stage-node[data-side='left'] .stage-row { justify-content: stretch; }
    .stage-badge { width: 100%; }
    .track-finish { width: 100%; }
  }
</style>
