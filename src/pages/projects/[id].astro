---
// Single project brief page ("/projects/[id]"), one per entry in the
// `projects` collection. `milestones` falls back to a synthetic list built
// from `tasks` when a project doesn't define its own, and `rubric` falls
// back to one built from `artifacts` — so a minimal project YAML (just
// tasks + artifacts) still renders a complete-looking brief without every
// project having to hand-author every field. See content/projects/README.md.
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
export async function getStaticPaths() { const projects = await getCollection('projects'); return projects.map((project) => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const skills = (await Promise.all(project.data.skills.map((id) => getEntry('skills', id)))).filter(Boolean);
const problem = project.data.problem_statement ?? project.data.description;
const milestones = project.data.milestones.length ? project.data.milestones : project.data.tasks.map((task, index) => ({ title: `Step ${index + 1}`, description: task }));
const rubric = project.data.rubric.length ? project.data.rubric : project.data.artifacts.map((artifact) => ({ criterion: artifact, definition: `The final submission includes a clear, usable ${artifact.toLowerCase()}.` }));
---

<Base title={project.data.title} description={project.data.description} wide>
  <header class="brief-hero"><div><div class="brief-tags"><span>{project.data.level} project</span><span>{project.data.duration}</span></div><h1>{project.data.title}</h1><p>{project.data.description}</p></div><aside><span>Brief includes</span><b>Problem & scenario</b><b>Downloadable dataset</b><b>Milestones & requirements</b><b>Deliverables & rubric</b></aside></header>
  <div class="brief-layout"><nav class="brief-nav"><strong>In this brief</strong><a href="#problem">01 Problem</a><a href="#dataset">02 Dataset</a><a href="#requirements">03 Requirements</a><a href="#milestones">04 Milestones</a><a href="#deliverables">05 Deliverables</a><a href="#rubric">06 Review rubric</a></nav><article class="brief-content">
    <section id="problem" class="content-section"><span class="section-no">01</span><div><small>The assignment</small><h2>Problem statement</h2><p class="lead">{problem}</p>{project.data.scenario && <div class="scenario"><strong>Your role</strong><p>{project.data.scenario}</p></div>}</div></section>
    <section id="dataset" class="content-section"><span class="section-no">02</span><div><small>Working material</small><h2>Dataset</h2>{project.data.dataset ? <div class="dataset-card"><div><span class="file-icon">CSV</span><div><strong>{project.data.dataset.name}</strong><p>{project.data.dataset.description}</p><small>{project.data.dataset.format}{project.data.dataset.size ? ` · ${project.data.dataset.size}` : ''}</small></div></div>{project.data.dataset.source_url && <a href={project.data.dataset.source_url} download>Download dataset ↓</a>}<div class="file-list">{project.data.dataset.files.map((file) => <a href={`/datasets/${file}`} download>{file} ↓</a>)}</div></div> : <ul>{project.data.datasets.map((item) => <li>{item}</li>)}</ul>}<p class="data-note">All bundled datasets are synthetic and safe for learning. Validate their quality as part of the assignment.</p></div></section>
    <section id="requirements" class="content-section"><span class="section-no">03</span><div><small>Definition of done</small><h2>Requirements</h2><div class="requirements">{(project.data.requirements.length ? project.data.requirements : project.data.tasks).map((item,index) => <div><span>{String(index+1).padStart(2,'0')}</span><p>{item}</p></div>)}</div></div></section>
    <section id="milestones" class="content-section"><span class="section-no">04</span><div><small>Suggested execution plan</small><h2>Milestones</h2><div class="milestones">{milestones.map((item,index) => <div><span>{index+1}</span><div><strong>{item.title}</strong><p>{item.description}</p></div></div>)}</div></div></section>
    <section id="deliverables" class="content-section"><span class="section-no">05</span><div><small>What to submit</small><h2>Expected deliverables</h2><div class="deliverables">{project.data.artifacts.map((artifact) => <span>✓ {artifact}</span>)}</div><div class="skill-links"><strong>Skills this project exercises</strong>{skills.map((skill) => skill && <a href={`/skills/${skill.id}`}>{skill.data.title} ↗</a>)}</div></div></section>
    <section id="rubric" class="content-section"><span class="section-no">06</span><div><small>Self-review before sharing</small><h2>Review rubric</h2><div class="rubric">{rubric.map((item,index) => <div><span>{String(index+1).padStart(2,'0')}</span><div><strong>{item.criterion}</strong><p>{item.definition}</p></div></div>)}</div></div></section>
  </article></div>
</Base>

<style>
  .brief-hero{display:grid;grid-template-columns:1fr 270px;gap:70px;padding:15px 0 55px}.back-link{display:inline-block;margin-bottom:25px;color:var(--muted);font-size:11px;font-weight:700}.brief-tags{display:flex;gap:7px}.brief-tags span{padding:5px 8px;border-radius:7px;background:var(--green-soft);color:var(--green-dark);font-size:8px;font-weight:850;text-transform:uppercase}.brief-tags span:last-child{background:#eef1ed;color:#68736b}.brief-hero h1{max-width:850px;margin:15px 0 0;font-size:clamp(44px,6vw,70px);letter-spacing:-.06em;line-height:.98}.brief-hero>div>p{max-width:720px;margin:16px 0 0;color:var(--muted);font-size:17px}.brief-hero aside{align-self:end;padding:20px;border:1px solid var(--line);border-radius:15px;background:white}.brief-hero aside span,.brief-hero aside b{display:block}.brief-hero aside span{margin-bottom:8px;color:#88938b;font-size:8px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.brief-hero aside b{padding:7px 0;border-bottom:1px solid #edf0ed;font-size:10px}
  .brief-layout{display:grid;grid-template-columns:170px 1fr;gap:50px}.brief-nav{position:sticky;top:95px;align-self:start;display:flex;flex-direction:column;gap:4px}.brief-nav strong{margin:0 7px 8px;color:#7c877f;font-size:8px;text-transform:uppercase}.brief-nav a{padding:6px 7px;border-radius:7px;color:#6d7970;font-size:10px}.brief-nav a:hover{background:white;color:var(--green)}.brief-content{min-width:0}.content-section{display:grid;grid-template-columns:38px 1fr;gap:18px;padding:48px 0;border-top:1px solid var(--line);scroll-margin-top:80px}.section-no{padding-top:3px;color:#9aa49c;font-size:9px;font-weight:850}.content-section small{color:var(--green);font-size:8px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.content-section h2{margin:2px 0 18px;font-size:29px;letter-spacing:-.04em}.lead{max-width:800px;margin:0;color:#3e4942;font-size:17px;line-height:1.7}.scenario{margin-top:20px;padding:15px 18px;border-left:3px solid var(--green);background:#eef7f0}.scenario strong{font-size:9px;text-transform:uppercase}.scenario p{margin:3px 0 0;color:var(--muted);font-size:12px}
  .dataset-card{padding:18px;border:1px solid #b9d1c1;border-radius:14px;background:#f1f8f3}.dataset-card>div:first-child{display:flex;gap:13px}.file-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:10px;background:var(--green);color:white;font-size:9px;font-weight:850}.dataset-card strong{display:block;font-size:13px}.dataset-card p{max-width:700px;margin:2px 0;color:var(--muted);font-size:10px}.dataset-card small{color:#728078;font-size:8px;text-transform:none}.dataset-card>a{display:inline-flex;margin-top:15px;padding:9px 12px;border-radius:8px;background:var(--green);color:white;font-size:9px;font-weight:800}.file-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.file-list a{padding:5px 7px;border-radius:6px;background:white;color:var(--green);font-size:8px;font-weight:700}.data-note{margin:9px 0 0;color:#88938b;font-size:8px}.requirements{display:grid;grid-template-columns:1fr 1fr;gap:8px}.requirements>div{display:grid;grid-template-columns:25px 1fr;gap:8px;padding:12px;border-radius:10px;background:white;border:1px solid var(--line)}.requirements span{color:#9ba59d;font-size:8px;font-weight:850}.requirements p{margin:0;color:#536057;font-size:10px}.milestones{position:relative;display:grid;gap:10px}.milestones:before{content:'';position:absolute;top:24px;bottom:24px;left:18px;width:2px;background:#d9e0da}.milestones>div{position:relative;display:grid;grid-template-columns:38px 1fr;gap:13px;padding:13px;border:1px solid var(--line);border-radius:11px;background:white}.milestones>div>span{z-index:1;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--green);color:white;font-size:10px;font-weight:850}.milestones strong{font-size:12px}.milestones p{margin:2px 0 0;color:var(--muted);font-size:10px}.deliverables{display:flex;flex-wrap:wrap;gap:7px}.deliverables span{padding:7px 10px;border-radius:8px;background:#eef5ef;color:var(--green-dark);font-size:9px;font-weight:750}.skill-links{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px;padding-top:15px;border-top:1px solid var(--line)}.skill-links strong{width:100%;font-size:9px;text-transform:uppercase}.skill-links a{color:var(--green);font-size:9px;font-weight:750}.rubric{display:grid;gap:7px}.rubric>div{display:grid;grid-template-columns:30px 1fr;gap:10px;padding:13px;border:1px solid var(--line);border-radius:10px;background:white}.rubric>div>span{color:#97a199;font-size:8px;font-weight:850}.rubric strong{font-size:11px}.rubric p{margin:2px 0 0;color:var(--muted);font-size:9px}
  @media(max-width:850px){.brief-hero{grid-template-columns:1fr;gap:25px}.brief-hero aside{display:none}.brief-layout{grid-template-columns:1fr}.brief-nav{display:none}}@media(max-width:600px){.content-section{grid-template-columns:1fr;gap:5px}.requirements{grid-template-columns:1fr}}
</style>
