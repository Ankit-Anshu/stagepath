---
// Group page — per topic.md's learning-group PRD. Sits between the main
// roadmap (which now shows one tile per learning chapter instead of one
// tile per individual skill on crowded stages) and the existing, unmodified
// skill note pages. Shows only topic names — no description, subtitle,
// progress, time estimate, or difficulty label, per the PRD's explicit
// "keep it small and clean" requirement.
//
// The chapter itself lives in the global `chapters` collection
// (multi_role_roadmaps.md) — a roadmap stage's `groups` field is just a
// list of chapter ids, so the same chapter can be reused by another
// roadmap/stage without duplicating its title or topic list.
import Base from '../../../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps');
  const paths: { params: { id: string; stageId: string; groupId: string }; props: { roadmap: (typeof roadmaps)[number]; stage: any; chapterId: string } }[] = [];
  for (const roadmap of roadmaps) {
    for (const stage of roadmap.data.stages) {
      for (const chapterId of stage.groups ?? []) {
        paths.push({ params: { id: roadmap.id, stageId: stage.id, groupId: chapterId }, props: { roadmap, stage, chapterId } });
      }
    }
  }
  return paths;
}

const { roadmap, stage, chapterId } = Astro.props;
const chapter = await getEntry('chapters', chapterId);
const skills = (await Promise.all(chapter!.data.skills.map((id: string) => getEntry('skills', id)))).filter(Boolean);
---

<Base title={`${chapter!.data.title} · ${roadmap.data.title}`} description={`Topics in ${chapter!.data.title}, part of the ${stage.title} stage.`}>
  <div class="group-page">
    <a href={`/roadmaps/${roadmap.id}#stage-${stage.id}`} class="back-link">← Back to {stage.title}</a>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`/roadmaps/${roadmap.id}`}>{roadmap.data.title}</a>
      <span>/</span>
      <a href={`/roadmaps/${roadmap.id}#stage-${stage.id}`}>{stage.title}</a>
      <span>/</span>
      <span aria-current="page">{chapter!.data.title}</span>
    </nav>

    <h1>{chapter!.data.title}</h1>

    <div class="topic-grid">
      {skills.map((skill) => skill && (
        <a class="topic-card" href={`/skills/${skill.id}`}>{skill.data.title}</a>
      ))}
    </div>
  </div>
</Base>

<style>
  .group-page { max-width: 760px; margin: 0 auto; padding: 40px 0 90px; }
  .back-link { display: inline-block; margin-bottom: 22px; color: var(--muted); font-size: 12px; font-weight: 700; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; color: var(--muted); font-size: 11px; font-weight: 650; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--green); }
  .crumbs span[aria-current] { color: var(--ink); font-weight: 750; }
  h1 { margin: 0 0 30px; font-size: clamp(32px, 5vw, 46px); letter-spacing: -.05em; line-height: 1; }
  .topic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .topic-card { display: flex; align-items: center; justify-content: center; min-height: 56px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: white; color: var(--ink); font-size: 13px; font-weight: 650; text-align: center; line-height: 1.3; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .topic-card:hover { border-color: var(--green); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(20, 108, 67, .12); color: var(--green-dark); }
  @media (max-width: 600px) {
    .topic-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
  }
</style>
