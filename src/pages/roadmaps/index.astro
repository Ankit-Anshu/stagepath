---
// Career roadmaps index ("/roadmaps"). Lists every entry from the
// `roadmaps` content collection as a card, grouped by category in a fixed
// display order. Each card links to the roadmap's own detail page
// (roadmaps/[id].astro), which renders the actual stage → skill track.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const roadmaps = await getCollection('roadmaps');
const categories = ['Software Development', 'Cybersecurity', 'Design', 'Data'];
roadmaps.sort((a, b) => categories.indexOf(a.data.category) - categories.indexOf(b.data.category) || a.data.title.localeCompare(b.data.title));
const skills = await getCollection('skills');
const skillById = new Map(skills.map((skill) => [skill.id, skill]));
const accents: Record<string, string> = { 'Software Development': 'green', Cybersecurity: 'amber', Design: 'blue', Data: 'violet' };
---

<Base title="Career Roadmaps" description="Structured learning roadmaps across software, security, design, and data." wide>
  <header class="catalog-header">
    <div><h1 class="display-title">Roadmaps</h1></div>
    <div class="catalog-intro"><p>Every roadmap breaks a career into stages, topics, and real projects.</p><a href="/start">Not sure? Use the path finder →</a></div>
  </header>

  <div class="filters" aria-label="Roadmap categories"><button class="active" data-filter="all">All paths</button>{categories.map((category) => <button data-filter={category}>{category}</button>)}</div>

  <div class="roadmap-grid" id="roadmap-grid">
    {roadmaps.map((roadmap, index) => {
      const ids = roadmap.data.stages.flatMap((stage) => stage.skills);
      const depth = ids.reduce((sum, id) => sum + (skillById.get(id)?.data.subtopics.length || skillById.get(id)?.data.objectives.length || 0), 0);
      return (
        <a href={`/roadmaps/${roadmap.id}`} class={`roadmap-card ${accents[roadmap.data.category] ?? 'green'}`} data-category={roadmap.data.category}>
          <div class="card-top"><span>{String(index + 1).padStart(2, '0')}</span></div>
          <p class="category">{roadmap.data.category}</p><h2>{roadmap.data.title}</h2>
          <div class="card-stats"><span><b>{roadmap.data.stages.length}</b> stages</span><span><b>{ids.length}</b> topics</span><span><b>{depth}</b> subtopics</span><span><b>~{roadmap.data.estimated_hours}h</b> effort</span></div>
        </a>
      );
    })}
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-category]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
      cards.forEach((card) => card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter);
    }));
  </script>
</Base>

<style>
  .catalog-header { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 60px; padding: 22px 0 55px; }.catalog-header .display-title { color: var(--green); font-size: clamp(46px,6vw,72px); }.catalog-intro p { margin: 0; color: var(--muted); font-size: 16px; }.catalog-intro a { display: inline-block; margin-top: 15px; color: var(--green); font-size: 12px; font-weight: 800; }
  .filters { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 22px; }.filters button { padding: 7px 11px; border: 1px solid var(--line); border-radius: 9px; background: white; color: var(--muted); font-size: 10px; font-weight: 750; }.filters button.active { border-color: var(--green); background: var(--green); color: white; }
  .roadmap-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }.roadmap-card { position: relative; overflow: hidden; display: flex; flex-direction: column; min-height: 150px; padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: white; transition: transform .18s,box-shadow .18s; }.roadmap-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(22,43,37,.1); }.roadmap-card::after { content:''; position:absolute; right:-45px; bottom:-55px; width:130px; height:130px; border-radius:50%; background:#6bc58c; opacity:.13; }.roadmap-card.amber::after { background:#e6a426; }.roadmap-card.blue::after { background:#547bd7; }.roadmap-card.violet::after { background:#8667c8; }
  .card-top { display:flex; justify-content:space-between; color:#8c968f; font-size:9px; font-weight:800; }.category { margin:14px 0 2px; color:var(--green); font-size:8px; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }.amber .category { color:#9a680e; }.blue .category { color:#4966a5; }.violet .category { color:#7156a9; }.roadmap-card h2 { margin:0; font-size:18px; letter-spacing:-.03em; }
  .card-stats { position:relative; z-index:1; display:flex; flex-wrap:wrap; gap:12px; margin-top:auto; padding-top:14px; }.card-stats span { color:#869088; font-size:7px; text-transform:uppercase; }.card-stats b { display:block; color:var(--ink); font-size:11px; text-transform:none; }
  @media(max-width:850px){.catalog-header{grid-template-columns:1fr;gap:20px}.roadmap-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.roadmap-grid{grid-template-columns:1fr}.card-stats{gap:10px;flex-wrap:wrap}}
</style>
