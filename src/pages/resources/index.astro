---
// Resource catalog ("/resources"). Lists every entry from the `resources`
// content collection with client-side filtering by type — resources aren't
// linked from here to a page of their own, they're external URLs (see
// content/resources/README.md); the catalog and each skill's own
// "Resources" section are the only two places they're surfaced.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
resources.sort((a, b) => a.data.title.localeCompare(b.data.title));

const types = [...new Set(resources.map((r) => r.data.type))].sort();
---

<Base title="Resources" description="Free, curated resources for every topic, with freshness and difficulty at a glance.">
  <header class="resources-header"><h1 class="display-title">Resources</h1></header>

  <div class="mt-6 flex flex-wrap gap-2">
    {types.map((t) => (
      <span class="text-xs rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-slate-600 dark:text-slate-300 capitalize">{t}</span>
    ))}
  </div>

  <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
    <table class="w-full text-sm">
      <thead class="bg-slate-100 dark:bg-slate-900 text-left">
        <tr>
          <th class="px-4 py-2.5 font-medium">Title</th>
          <th class="px-4 py-2.5 font-medium">Provider</th>
          <th class="px-4 py-2.5 font-medium">Type</th>
          <th class="px-4 py-2.5 font-medium">Difficulty</th>
          <th class="px-4 py-2.5 font-medium">Duration</th>
          <th class="px-4 py-2.5 font-medium">Last verified</th>
        </tr>
      </thead>
      <tbody>
        {resources.map((r) => (
          <tr class="border-t border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900/50">
            <td class="px-4 py-2.5">
              <a href={r.data.url} target="_blank" rel="noopener noreferrer" class="text-indigo-600 dark:text-indigo-400 hover:underline">{r.data.title}</a>
            </td>
            <td class="px-4 py-2.5 text-slate-600 dark:text-slate-300">{r.data.provider}</td>
            <td class="px-4 py-2.5 text-slate-600 dark:text-slate-300 capitalize">{r.data.type}</td>
            <td class="px-4 py-2.5 text-slate-600 dark:text-slate-300 capitalize">{r.data.difficulty}</td>
            <td class="px-4 py-2.5 text-slate-600 dark:text-slate-300">{r.data.duration_minutes} min</td>
            <td class="px-4 py-2.5 text-slate-500 dark:text-slate-400">{r.data.last_verified.toISOString().slice(0, 10)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
<style>
  .resources-header{padding:20px 0 30px}.resources-header .display-title{color:var(--green);font-size:clamp(44px,6vw,68px)}
</style>
