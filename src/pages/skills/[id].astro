---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';
export async function getStaticPaths() { const skills = await getCollection('skills'); return skills.map((skill) => ({ params:{ id:skill.id }, props:{ skill } })); }
const { skill } = Astro.props;
const allSkills = await getCollection('skills');
const skillById = new Map(allSkills.map((item) => [item.id,item]));
const roadmaps = (await getCollection('roadmaps')).filter((roadmap) => roadmap.data.stages.some((stage) => stage.skills.includes(skill.id)));
const projects = (await getCollection('projects')).filter((project) => project.data.skills.includes(skill.id));
const resources = (await Promise.all(skill.data.resources.map((id) => getEntry('resources',id)))).filter(Boolean);
const subtopics = skill.data.subtopics.length ? skill.data.subtopics : skill.data.objectives.map((objective) => ({ title:objective, description:'A required outcome to demonstrate before moving forward.', outcomes:[] }));
const noteHtml = skill.data.note ? marked.parse(skill.data.note) : null;

// Learning-group context (topic.md PRD): if this skill sits inside a
// roadmap stage's `groups`, show a small breadcrumb back to that group and
// prev/next links to its neighbors in the same group. Skills outside any
// group (most of the app, still) render exactly as before — this block is
// purely additive. `groups` on a stage is a list of shared chapter ids
// (multi_role_roadmaps.md) — the title and topic order live on the
// chapter, not the roadmap, so the same chapter can be reused elsewhere.
const allChapters = await getCollection('chapters');
const chapterById = new Map(allChapters.map((chapter) => [chapter.id, chapter]));
let groupContext: { roadmapId: string; roadmapTitle: string; stageId: string; stageTitle: string; groupId: string; groupTitle: string; prevId: string | null; nextId: string | null } | null = null;
outer: for (const rm of roadmaps) {
  for (const st of rm.data.stages) {
    for (const chapterId of st.groups ?? []) {
      const chapter = chapterById.get(chapterId);
      if (!chapter) continue;
      const idx = chapter.data.skills.indexOf(skill.id);
      if (idx === -1) continue;
      groupContext = {
        roadmapId: rm.id, roadmapTitle: rm.data.title,
        stageId: st.id, stageTitle: st.title,
        groupId: chapterId, groupTitle: chapter.data.title,
        prevId: idx > 0 ? chapter.data.skills[idx - 1] : null,
        nextId: idx < chapter.data.skills.length - 1 ? chapter.data.skills[idx + 1] : null,
      };
      break outer;
    }
  }
}
const prevSkill = groupContext?.prevId ? await getEntry('skills', groupContext.prevId) : null;
const nextSkill = groupContext?.nextId ? await getEntry('skills', groupContext.nextId) : null;
---
<Base title={skill.data.title} description={skill.data.what_is_it} wide>
  {groupContext && (
    <div class="group-context">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/roadmaps/${groupContext.roadmapId}`}>{groupContext.roadmapTitle}</a>
        <span>/</span>
        <a href={`/roadmaps/${groupContext.roadmapId}#stage-${groupContext.stageId}`}>{groupContext.stageTitle}</a>
        <span>/</span>
        <a href={`/roadmaps/${groupContext.roadmapId}/${groupContext.stageId}/${groupContext.groupId}`}>{groupContext.groupTitle}</a>
      </nav>
      <div class="topic-pager">
        {prevSkill ? <a href={`/skills/${prevSkill.id}`}>← {prevSkill.data.title}</a> : <span />}
        {nextSkill ? <a href={`/skills/${nextSkill.id}`}>{nextSkill.data.title} →</a> : <span />}
      </div>
    </div>
  )}
  <header class="topic-hero"><div><a href="/skills" class="back-link">← Topic library</a><span class="topic-category">{skill.data.category}</span><h1>{skill.data.title}</h1><p>{skill.data.what_is_it}</p></div><aside><span>Syllabus depth</span><div><b>{subtopics.length}</b><small>subtopics</small></div>{skill.data.estimated_minutes && <div><b>~{Math.max(1,Math.round(skill.data.estimated_minutes/60))}h</b><small>estimated effort</small></div>}</aside></header>
  <div class="topic-layout"><nav><strong>On this page</strong>{noteHtml && <a href="#note">00 Knowledge note</a>}<a href="#why">01 Why it matters</a><a href="#syllabus">02 Detailed syllabus</a><a href="#outcomes">03 Outcomes</a><a href="#resources">04 Resources</a><a href="#projects">05 Projects</a></nav><article>
    {noteHtml && <section id="note"><span>00</span><div><small>Full knowledge note</small><div class="note-body" set:html={noteHtml} /></div></section>}
    <section id="why"><span>01</span><div><small>Context</small><h2>Why it matters</h2><p class="lead">{skill.data.why_it_matters}</p>{roadmaps.length>0&&<div class="used-in"><strong>Appears in</strong>{roadmaps.map((roadmap)=><a href={`/roadmaps/${roadmap.id}`}>{roadmap.data.title} ↗</a>)}</div>}</div></section>
    <section id="syllabus"><span>02</span><div><small>Detailed syllabus</small><h2>What to learn</h2><div class="syllabus">{subtopics.map((subtopic,index)=><details open={index===0}><summary><span>{String(index+1).padStart(2,'0')}</span><strong>{subtopic.title}</strong><b>+</b></summary><div><p>{subtopic.description}</p>{subtopic.outcomes.length>0&&<ul>{subtopic.outcomes.map((outcome)=><li>{outcome}</li>)}</ul>}</div></details>)}</div></div></section>
    <section id="outcomes"><span>03</span><div><small>Proof of understanding</small><h2>You should be able to</h2><div class="outcomes">{skill.data.objectives.map((objective,index)=><div><b>✓</b><span><small>Outcome {index+1}</small><p>{objective}</p></span></div>)}</div>{skill.data.verify.length>0&&<div class="verify"><strong>Self-review prompts</strong>{skill.data.verify.map((item)=><p>□ {item}</p>)}</div>}</div></section>
    <section id="resources"><span>04</span><div><small>Curated starting points</small><h2>Resources</h2>{resources.length?<div class="resources">{resources.map((resource)=>resource&&<a href={resource.data.url} target="_blank" rel="noopener noreferrer"><span>{resource.data.type}</span><div><strong>{resource.data.title}</strong><p>{resource.data.provider} · ~{resource.data.duration_minutes} min · {resource.data.difficulty}</p></div><b>↗</b></a>)}</div>:<p class="empty">Resource curation is in progress. Use the syllabus above to evaluate any course or tutorial you choose.</p>}</div></section>
    <section id="projects"><span>05</span><div><small>Apply the topic</small><h2>Related projects</h2>{projects.length?<div class="projects">{projects.map((project)=><a href={`/projects/${project.id}`}><span>{project.data.level}</span><strong>{project.data.title}</strong><p>{project.data.problem_statement??project.data.description}</p><b>{project.data.duration} · Full brief ↗</b></a>)}</div>:<p class="empty">A dedicated project brief for this topic has not been published yet.</p>}</div></section>
  </article></div>
</Base>
<style>
  .group-context{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-top:15px;padding:10px 14px;border:1px solid var(--line);border-radius:11px;background:#fafbf8;font-size:11px}
  .group-context .crumbs{display:flex;flex-wrap:wrap;gap:6px;color:var(--muted);font-weight:650}
  .group-context .crumbs a{color:var(--muted)}
  .group-context .crumbs a:hover{color:var(--green)}
  .group-context .crumbs a:last-of-type{color:var(--green-dark);font-weight:750}
  .group-context .topic-pager{display:flex;gap:16px}
  .group-context .topic-pager a{color:var(--green);font-weight:750}
  .group-context .topic-pager a:hover{text-decoration:underline}
  .topic-hero{display:grid;grid-template-columns:1fr 230px;gap:70px;padding:15px 0 55px}.back-link{display:block;margin-bottom:25px;color:var(--muted);font-size:11px;font-weight:700}.topic-category{padding:5px 8px;border-radius:7px;background:var(--green-soft);color:var(--green);font-size:8px;font-weight:850;text-transform:uppercase}.topic-hero h1{margin:15px 0 0;font-size:clamp(44px,6vw,70px);letter-spacing:-.06em;line-height:1}.topic-hero>div>p{max-width:760px;margin:16px 0 0;color:var(--muted);font-size:17px}.topic-hero aside{align-self:end;padding:19px;border:1px solid var(--line);border-radius:14px;background:white}.topic-hero aside>span{display:block;margin-bottom:7px;color:#869188;font-size:8px;font-weight:850;text-transform:uppercase}.topic-hero aside>div{display:flex;align-items:baseline;justify-content:space-between;padding:8px 0;border-bottom:1px solid #edf0ed}.topic-hero aside b{font-size:19px}.topic-hero aside small{color:var(--muted);font-size:8px}.topic-layout{display:grid;grid-template-columns:170px 1fr;gap:50px}.topic-layout>nav{position:sticky;top:95px;align-self:start;display:flex;flex-direction:column;gap:4px}.topic-layout>nav strong{margin:0 7px 8px;color:#7d887f;font-size:8px;text-transform:uppercase}.topic-layout>nav a{padding:6px 7px;border-radius:7px;color:#69756c;font-size:10px}.topic-layout>nav a:hover{background:white;color:var(--green)}article>section{display:grid;grid-template-columns:36px 1fr;gap:17px;padding:48px 0;border-top:1px solid var(--line);scroll-margin-top:80px}article>section>span{color:#9aa49c;font-size:8px;font-weight:850}article section div>small{color:var(--green);font-size:8px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}article h2{margin:2px 0 18px;font-size:29px;letter-spacing:-.04em}.lead{max-width:800px;color:#445048;font-size:16px;line-height:1.7}.used-in{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.used-in strong{width:100%;font-size:9px;text-transform:uppercase}.used-in a{color:var(--green);font-size:9px;font-weight:750}.syllabus{display:grid;gap:7px}.syllabus details{overflow:hidden;border:1px solid var(--line);border-radius:11px;background:white}.syllabus summary{display:grid;grid-template-columns:30px 1fr 24px;align-items:center;gap:9px;padding:13px;cursor:pointer;list-style:none}.syllabus summary::-webkit-details-marker{display:none}.syllabus summary>span{color:#9ba59d;font-size:8px;font-weight:850}.syllabus summary strong{font-size:11px}.syllabus summary b{color:var(--green);font-size:15px}.syllabus details[open] summary b{transform:rotate(45deg)}.syllabus details>div{padding:0 52px 14px;border-top:1px solid #edf0ed}.syllabus details p{color:var(--muted);font-size:10px}.syllabus ul{padding-left:16px;color:var(--green-dark);font-size:9px}.outcomes{display:grid;grid-template-columns:1fr 1fr;gap:8px}.outcomes>div{display:grid;grid-template-columns:24px 1fr;gap:8px;padding:12px;border:1px solid var(--line);border-radius:10px;background:white}.outcomes>div>b{color:var(--green)}.outcomes p{margin:1px 0;color:#536057;font-size:10px}.verify{margin-top:15px;padding:15px;border-left:3px solid var(--green);background:#eef6ef}.verify strong{font-size:9px;text-transform:uppercase}.verify p{margin:5px 0;color:var(--muted);font-size:9px}.resources,.projects{display:grid;gap:8px}.resources>a{display:grid;grid-template-columns:70px 1fr 20px;gap:10px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:10px;background:white}.resources>a>span{color:var(--green);font-size:8px;font-weight:800;text-transform:uppercase}.resources strong{font-size:10px}.resources p{margin:1px 0;color:var(--muted);font-size:8px}.resources>a>b{color:#89948c}.projects{grid-template-columns:1fr 1fr}.projects>a{padding:15px;border:1px solid var(--line);border-radius:11px;background:white}.projects>a>span{color:var(--green);font-size:7px;font-weight:850;text-transform:uppercase}.projects strong{display:block;margin-top:6px;font-size:12px}.projects p{display:-webkit-box;overflow:hidden;color:var(--muted);font-size:9px;-webkit-box-orient:vertical;-webkit-line-clamp:3}.projects b{color:var(--green);font-size:8px}.empty{padding:15px;border-radius:10px;background:#f1f4f0;color:var(--muted);font-size:10px}@media(max-width:800px){.topic-hero{grid-template-columns:1fr}.topic-hero aside{display:none}.topic-layout{grid-template-columns:1fr}.topic-layout>nav{display:none}}@media(max-width:580px){article>section{grid-template-columns:1fr;gap:5px}.outcomes,.projects{grid-template-columns:1fr}.syllabus details>div{padding-left:14px}}
</style>
<style is:global>
  /* .note-body is populated via set:html from markdown, so its children never
     receive Astro's scoped data-astro-cid attribute — these rules must be global. */
  .note-body{max-width:820px;color:#3c463f;font-size:13px;line-height:1.75}
  .note-body h1{display:none}
  .note-body h2{margin:34px 0 12px;padding-top:22px;border-top:1px solid var(--line);font-size:19px;letter-spacing:-.02em;color:#1c231e}
  .note-body h2:first-child{margin-top:0;padding-top:0;border-top:none}
  .note-body h3{margin:22px 0 9px;font-size:14px;font-weight:800;color:var(--green-dark)}
  .note-body h4{margin:16px 0 7px;font-size:11px;font-weight:850;text-transform:uppercase;letter-spacing:.04em;color:#6b766e}
  .note-body p{margin:9px 0;color:#454f48}
  .note-body ul{margin:9px 0;padding-left:20px;color:#454f48;list-style:disc}
  .note-body ol{margin:9px 0;padding-left:20px;color:#454f48;list-style:decimal}
  .note-body li{margin:4px 0}
  .note-body li>ul,.note-body li>ol{margin:4px 0}
  .note-body strong{color:#1c231e}
  .note-body code{padding:2px 5px;border-radius:5px;background:#eef2ee;color:#1f4d2f;font-size:.9em;font-family:ui-monospace,'SF Mono',Consolas,monospace}
  .note-body pre{margin:12px 0;padding:14px 16px;overflow-x:auto;border-radius:11px;background:#101711;color:#dfe8e1}
  .note-body pre code{padding:0;background:none;color:inherit;font-size:11.5px;line-height:1.6}
  .note-body table{width:100%;margin:14px 0;border-collapse:collapse;font-size:12px}
  .note-body th,.note-body td{padding:8px 10px;border:1px solid var(--line);text-align:left}
  .note-body th{background:#f4f7f4;font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:#6b766e}
  .note-body blockquote{margin:12px 0;padding:10px 14px;border-left:3px solid var(--green);background:#eef6ef;color:#3c463f;font-size:12px}
  .note-body hr{margin:24px 0;border:none;border-top:1px solid var(--line)}
  .note-body details{margin:8px 0;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:#fafbfa}
  .note-body details summary{cursor:pointer;font-weight:750;font-size:12px;color:var(--green-dark)}
  .note-body details[open] summary{margin-bottom:8px}
  .note-body a{color:var(--green);text-decoration:underline;text-underline-offset:2px}
</style>
