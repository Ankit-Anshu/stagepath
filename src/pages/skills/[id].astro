---
// Single skill/topic page ("/skills/[id]"), one per entry in the `skills`
// collection — the "notes page" a learner spends most of their time on:
// full knowledge note (markdown, auto-TOC'd below), why it matters, a
// self-review checklist, curated resources, and related projects. See
// content/skills/README.md for the YAML schema and ARCHITECTURE.md for how
// the note markdown is parsed and heading-anchored at build time.
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';
export async function getStaticPaths() { const skills = await getCollection('skills'); return skills.map((skill) => ({ params:{ id:skill.id }, props:{ skill } })); }
const { skill } = Astro.props;
const roadmaps = (await getCollection('roadmaps')).filter((roadmap) => roadmap.data.stages.some((stage) => stage.skills.includes(skill.id)));
const projects = (await getCollection('projects')).filter((project) => project.data.skills.includes(skill.id));
const resources = (await Promise.all(skill.data.resources.map((id) => getEntry('resources',id)))).filter(Boolean);
// The knowledge note is one long hand-written markdown block per skill
// (what is it / examples / common mistakes / interview prep / quick
// revision, ...). For a learner that's a lot to scroll through, so at build
// time we tag every H2 (plus any "quick revision"-style H3 recap) with a
// stable id and collect them into a mini table of contents rendered in the
// sticky sidebar — letting someone jump straight to "Interview preparation"
// without hand-editing any of the 300 note files individually.
let noteHtml: string | null = null;
let noteHeadings: { id: string; text: string; level: 2 | 3 }[] = [];
let noteReadMinutes = 0;
if (skill.data.note) {
  noteReadMinutes = Math.max(1, Math.round(skill.data.note.trim().split(/\s+/).length / 200));
  const rawHtml = marked.parse(skill.data.note) as string;
  const usedIds = new Set<string>();
  const stripEmoji = (s: string) => s.replace(/\p{Extended_Pictographic}/gu, '').replace(/️/g, '');
  const plainText = (html: string) => stripEmoji(html.replace(/<[^>]+>/g, '')).replace(/\s+/g, ' ').trim();
  const slugify = (text: string) => {
    const base = text.toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-') || 'section';
    let id = base;
    let n = 2;
    while (usedIds.has(id)) id = `${base}-${n++}`;
    usedIds.add(id);
    return id;
  };
  noteHtml = rawHtml
    .replace(/<h2>([\s\S]*?)<\/h2>/g, (_match, inner) => {
      const text = plainText(inner);
      const id = slugify(text);
      noteHeadings.push({ id, text: text || 'Section', level: 2 });
      return `<h2 id="${id}">${inner}</h2>`;
    })
    .replace(/<h3>([\s\S]*?)<\/h3>/g, (match, inner) => {
      const text = plainText(inner);
      if (!/revision|cheat.?sheet|recap|summary/i.test(text)) return match;
      const id = slugify(text);
      noteHeadings.push({ id, text: text || 'Section', level: 3 });
      return `<h3 id="${id}" class="note-revision-heading">${inner}</h3>`;
    });
}

// Learning-group context (topic.md PRD): if this skill sits inside a
// roadmap stage's `groups`, show a small breadcrumb back to that group and
// prev/next links to its neighbors in the same group. Skills outside any
// group (most of the app, still) render exactly as before — this block is
// purely additive. `groups` on a stage is a list of shared chapter ids
// The title and topic order live on the chapter, not the roadmap, so the
// same chapter can be reused elsewhere.
const allChapters = await getCollection('chapters');
const chapterById = new Map(allChapters.map((chapter) => [chapter.id, chapter]));
let groupContext: { roadmapId: string; roadmapTitle: string; stageId: string; stageTitle: string; groupId: string; groupTitle: string; prevId: string | null; nextId: string | null } | null = null;
outer: for (const rm of roadmaps) {
  for (const st of rm.data.stages) {
    for (const chapterId of st.groups ?? []) {
      const chapter = chapterById.get(chapterId);
      if (!chapter) continue;
      const idx = chapter.data.skills.indexOf(skill.id);
      if (idx === -1) continue;
      groupContext = {
        roadmapId: rm.id, roadmapTitle: rm.data.title,
        stageId: st.id, stageTitle: st.title,
        groupId: chapterId, groupTitle: chapter.data.title,
        prevId: idx > 0 ? chapter.data.skills[idx - 1] : null,
        nextId: idx < chapter.data.skills.length - 1 ? chapter.data.skills[idx + 1] : null,
      };
      break outer;
    }
  }
}
const prevSkill = groupContext?.prevId ? await getEntry('skills', groupContext.prevId) : null;
const nextSkill = groupContext?.nextId ? await getEntry('skills', groupContext.nextId) : null;
---
<Base title={skill.data.title} description={skill.data.what_is_it} wide>
  {groupContext && (
    <div class="group-context">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/roadmaps/${groupContext.roadmapId}`}>{groupContext.roadmapTitle}</a>
        <span>/</span>
        <a href={`/roadmaps/${groupContext.roadmapId}#stage-${groupContext.stageId}`}>{groupContext.stageTitle}</a>
        <span>/</span>
        <a href={`/roadmaps/${groupContext.roadmapId}/${groupContext.stageId}/${groupContext.groupId}`}>{groupContext.groupTitle}</a>
      </nav>
      <div class="topic-pager">
        {prevSkill ? <a href={`/skills/${prevSkill.id}`}>← {prevSkill.data.title}</a> : <span />}
        {nextSkill ? <a href={`/skills/${nextSkill.id}`}>{nextSkill.data.title} →</a> : <span />}
      </div>
    </div>
  )}
  <header class="topic-hero"><div><span class="topic-category">{skill.data.category}</span><h1>{skill.data.title}</h1><p>{skill.data.what_is_it}</p></div><aside><span>At a glance</span><div><b>{skill.data.objectives.length}</b><small>outcomes</small></div>{skill.data.estimated_minutes && <div><b>~{Math.max(1,Math.round(skill.data.estimated_minutes/60))}h</b><small>estimated effort</small></div>}</aside></header>
  <div class="topic-layout"><nav><strong>On this page</strong>
      {noteHtml && (
        <div class="nav-group">
          <a href="#note">00 Knowledge note</a>
          {noteHeadings.length > 0 && (
            <div class="nav-sub">
              {noteHeadings.map((heading) => <a href={`#${heading.id}`} class:list={{ deep: heading.level === 3 }}>{heading.text}</a>)}
            </div>
          )}
        </div>
      )}
      <a href="#why">01 Why it matters</a><a href="#outcomes">02 Outcomes</a><a href="#resources">03 Resources</a><a href="#projects">04 Projects</a></nav><article>
    {noteHtml && <section id="note"><span>00</span><div><small>Full knowledge note{noteReadMinutes > 0 && ` · ~${noteReadMinutes} min read`}</small><div class="note-body" set:html={noteHtml} /></div></section>}
    <section id="why"><span>01</span><div><small>Context</small><h2>Why it matters</h2><p class="lead">{skill.data.why_it_matters}</p>{roadmaps.length>0&&<div class="used-in"><strong>Appears in</strong>{roadmaps.map((roadmap)=><a href={`/roadmaps/${roadmap.id}`}>{roadmap.data.title} ↗</a>)}</div>}</div></section>
    <section id="outcomes"><span>02</span><div><small>Self-check</small><h2>Self-review before moving on</h2><ul class="outcomes">{skill.data.objectives.map((objective)=><li><i aria-hidden="true">✓</i><span>{objective}</span></li>)}</ul></div></section>
    <section id="resources"><span>03</span><div><small>Curated starting points</small><h2>Resources</h2>{resources.length?<div class="resources">{resources.map((resource)=>resource&&<a href={resource.data.url} target="_blank" rel="noopener noreferrer"><span>{resource.data.type}</span><div><strong>{resource.data.title}</strong><p>{resource.data.provider} · ~{resource.data.duration_minutes} min · {resource.data.difficulty}</p></div><b>↗</b></a>)}</div>:<p class="empty">Resource curation is in progress.</p>}</div></section>
    <section id="projects"><span>04</span><div><small>Apply the topic</small><h2>Related projects</h2>{projects.length?<div class="projects">{projects.map((project)=><a href={`/projects/${project.id}`}><span>{project.data.level}</span><strong>{project.data.title}</strong><p>{project.data.problem_statement??project.data.description}</p><b>{project.data.duration} · Full brief ↗</b></a>)}</div>:<p class="empty">A dedicated project brief for this topic has not been published yet.</p>}</div></section>
  </article></div>
</Base>
<style>
  .group-context{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-top:15px;padding:10px 14px;border:1px solid var(--line);border-radius:11px;background:#fafbf8;font-size:11px}
  .group-context .crumbs{display:flex;flex-wrap:wrap;gap:6px;color:var(--muted);font-weight:650}
  .group-context .crumbs a{color:var(--muted)}
  .group-context .crumbs a:hover{color:var(--green)}
  .group-context .crumbs a:last-of-type{color:var(--green-dark);font-weight:750}
  .group-context .topic-pager{display:flex;gap:16px}
  .group-context .topic-pager a{color:var(--green);font-weight:750}
  .group-context .topic-pager a:hover{text-decoration:underline}
  .topic-hero{display:grid;grid-template-columns:1fr 230px;gap:70px;padding:15px 0 55px}.back-link{display:block;margin-bottom:25px;color:var(--muted);font-size:11px;font-weight:700}.topic-category{padding:5px 8px;border-radius:7px;background:var(--green-soft);color:var(--green);font-size:8px;font-weight:850;text-transform:uppercase}.topic-hero h1{margin:15px 0 0;font-size:clamp(44px,6vw,70px);letter-spacing:-.06em;line-height:1}.topic-hero>div>p{max-width:760px;margin:16px 0 0;color:var(--muted);font-size:17px}.topic-hero aside{align-self:end;padding:19px;border:1px solid var(--line);border-radius:14px;background:white}.topic-hero aside>span{display:block;margin-bottom:7px;color:#869188;font-size:8px;font-weight:850;text-transform:uppercase}.topic-hero aside>div{display:flex;align-items:baseline;justify-content:space-between;padding:8px 0;border-bottom:1px solid #edf0ed}.topic-hero aside b{font-size:19px}.topic-hero aside small{color:var(--muted);font-size:8px}.topic-layout{display:grid;grid-template-columns:190px 1fr;gap:50px}.topic-layout>nav{position:sticky;top:95px;align-self:start;max-height:calc(100vh - 115px);overflow-y:auto;display:flex;flex-direction:column;gap:4px;scrollbar-width:thin}.topic-layout>nav strong{margin:0 7px 8px;color:#7d887f;font-size:8px;text-transform:uppercase}.topic-layout>nav>a{padding:6px 7px;border-radius:7px;color:#69756c;font-size:10px}.topic-layout>nav>a:hover{background:white;color:var(--green)}.nav-group{display:flex;flex-direction:column;gap:1px}.nav-group>a{padding:6px 7px;border-radius:7px;color:#69756c;font-size:10px}.nav-group>a:hover{background:white;color:var(--green)}.nav-sub{display:flex;flex-direction:column;gap:1px;margin:2px 0 6px;padding-left:11px;border-left:1px solid var(--line)}.nav-sub a{padding:5px 7px;border-radius:6px;color:#8b958c;font-size:9px;line-height:1.4}.nav-sub a.deep{padding-left:16px;font-style:italic}.nav-sub a:hover{background:white;color:var(--green)}article>section{display:grid;grid-template-columns:36px 1fr;gap:17px;padding:48px 0;border-top:1px solid var(--line);scroll-margin-top:80px}article>section>span{color:#9aa49c;font-size:8px;font-weight:850}article section div>small{color:var(--green);font-size:8px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}article h2{margin:2px 0 18px;font-size:29px;letter-spacing:-.04em}.lead{max-width:800px;color:#445048;font-size:16px;line-height:1.7}.used-in{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.used-in strong{width:100%;font-size:9px;text-transform:uppercase}.used-in a{color:var(--green);font-size:9px;font-weight:750}.outcomes{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none}.outcomes li{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid var(--line);border-radius:11px;background:white;transition:border-color .15s,box-shadow .15s}.outcomes li:hover{border-color:var(--green);box-shadow:0 3px 12px rgba(20,108,67,.07)}.outcomes li>i{flex:none;display:grid;place-items:center;width:23px;height:23px;margin-top:1px;border-radius:50%;background:var(--green-soft);color:var(--green);font-style:normal;font-size:12px;font-weight:850}.outcomes li>span{padding-top:2px;color:#333d36;font-size:13.5px;font-weight:550;line-height:1.55}.resources,.projects{display:grid;gap:8px}.resources>a{display:grid;grid-template-columns:70px 1fr 20px;gap:10px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:10px;background:white}.resources>a>span{color:var(--green);font-size:8px;font-weight:800;text-transform:uppercase}.resources strong{font-size:12px}.resources p{margin:1px 0;color:var(--muted);font-size:10.5px}.resources>a>b{color:#89948c}.projects{grid-template-columns:1fr 1fr}.projects>a{padding:15px;border:1px solid var(--line);border-radius:11px;background:white}.projects>a>span{color:var(--green);font-size:7px;font-weight:850;text-transform:uppercase}.projects strong{display:block;margin-top:6px;font-size:13px}.projects p{display:-webkit-box;overflow:hidden;color:var(--muted);font-size:11px;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:3}.projects b{color:var(--green);font-size:8px}.empty{padding:15px;border-radius:10px;background:#f1f4f0;color:var(--muted);font-size:12px}@media(max-width:800px){.topic-hero{grid-template-columns:1fr}.topic-hero aside{display:none}.topic-layout{grid-template-columns:1fr}.topic-layout>nav{display:none}}@media(max-width:580px){article>section{grid-template-columns:1fr;gap:5px}.projects{grid-template-columns:1fr}}
</style>
<style is:global>
  /* .note-body is populated via set:html from markdown, so its children never
     receive Astro's scoped data-astro-cid attribute — these rules must be global. */
  .note-body{max-width:800px;color:#333d36;font-size:15.5px;line-height:1.8}
  .note-body h1{display:none}
  .note-body h2{margin:40px 0 14px;padding-top:26px;border-top:1px solid var(--line);font-size:22px;letter-spacing:-.02em;color:#151d17;scroll-margin-top:90px}
  .note-body h2:first-child{margin-top:0;padding-top:0;border-top:none}
  .note-body h3{margin:26px 0 10px;font-size:16px;font-weight:800;color:var(--green-dark);scroll-margin-top:90px}
  .note-body h3.note-revision-heading{margin-top:30px;padding-top:0;border-top:none}
  .note-body h4{margin:18px 0 8px;font-size:11.5px;font-weight:850;text-transform:uppercase;letter-spacing:.04em;color:#6b766e}
  .note-body p{margin:11px 0;color:#3a443d}
  .note-body ul{margin:10px 0;padding-left:22px;color:#3a443d;list-style:disc}
  .note-body ol{margin:10px 0;padding-left:22px;color:#3a443d;list-style:decimal}
  .note-body li{margin:5px 0}
  .note-body li>ul,.note-body li>ol{margin:5px 0}
  .note-body strong{color:#151d17;font-weight:750}
  .note-body code{padding:2px 6px;border-radius:5px;background:#eef2ee;color:#1f4d2f;font-size:.88em;font-family:ui-monospace,'SF Mono',Consolas,monospace}
  .note-body pre{margin:14px 0;padding:16px 18px;overflow-x:auto;border-radius:12px;background:#101711;color:#dfe8e1;box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}
  .note-body pre code{padding:0;background:none;color:inherit;font-size:12.5px;line-height:1.65}
  .note-body table{width:100%;margin:16px 0;border-collapse:collapse;font-size:13px;border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .note-body th,.note-body td{padding:10px 12px;border-bottom:1px solid var(--line);border-right:1px solid var(--line);text-align:left}
  .note-body th:last-child,.note-body td:last-child{border-right:none}
  .note-body tr:last-child td{border-bottom:none}
  .note-body th{background:#f4f7f4;font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;color:#6b766e}
  .note-body tbody tr:hover{background:#fafcf9}
  .note-body blockquote{margin:14px 0;padding:12px 16px;border-left:3px solid var(--green);border-radius:0 8px 8px 0;background:#eef6ef;color:#333d36;font-size:13.5px}
  .note-body hr{margin:28px 0;border:none;border-top:1px solid var(--line)}
  .note-body details{margin:10px 0;padding:13px 15px;border:1px solid var(--line);border-radius:10px;background:#fafbfa;transition:border-color .15s,background .15s}
  .note-body details:hover{border-color:var(--green);background:#f7faf7}
  .note-body details summary{display:flex;align-items:center;gap:8px;cursor:pointer;list-style:none;font-weight:750;font-size:13px;color:var(--green-dark)}
  .note-body details summary::-webkit-details-marker{display:none}
  .note-body details summary::before{content:'▸';display:inline-block;color:var(--green);font-size:11px;transition:transform .15s}
  .note-body details[open] summary::before{transform:rotate(90deg)}
  .note-body details[open] summary{margin-bottom:10px}
  .note-body a{color:var(--green);text-decoration:underline;text-underline-offset:2px}
  .note-body a:hover{color:var(--green-dark)}
</style>
